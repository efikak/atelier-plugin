{
  "name": "effiek/quiz-atelier",
  "description": "Επαγγελματικό WordPress Quiz Atelier με custom tables, analytics, κατηγορίες και portable embeds.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12 || ^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "szepeviktor/phpstan-wordpress": "^1.3 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "WPQuizStudio\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPQuizStudio\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "authors": [
    {
      "name": "Έφη Κακούνη",
      "homepage": "https://effiek.gr"
    }
  ]
}
